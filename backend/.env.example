# --- GitHub (the account that owns the repos) ---
GITHUB_TOKEN=

# --- LLM ---
# auto = local if reachable, else DeepSeek. Can be overridden per run from the UI.
LLM_MODE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Any OpenAI-compatible server (Ollama, LM Studio, vLLM, llama.cpp). Leave empty to disable.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5-coder:14b

# --- Database (Supabase Postgres pooler URL, required) ---
DATABASE_URL=

# --- Repo secrets (same key as the web app; openssl rand -base64 32) ---
MOGO_SECRET_KEY=

# --- Observability ---
SENTRY_DSN=
ENVIRONMENT=dev
LOG_LEVEL=INFO
