# --- The Mogo GitHub App: reads PRs and posts reviews as mogo[bot] (README, Deploy, 2) ---
GITHUB_APP_ID=
# The .pem contents; one line with literal \n, or base64 of the file, also work.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=mogo

# --- Database (Supabase Postgres pooler URL, required) ---
DATABASE_URL=

# --- Decrypts repo secrets and users' LLM keys (same key as the web app; openssl rand -base64 32) ---
MOGO_SECRET_KEY=

# --- Observability ---
SENTRY_DSN=
ENVIRONMENT=dev
LOG_LEVEL=INFO
