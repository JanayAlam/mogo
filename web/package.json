{
  "name": "@mogo/web",
  "version": "1.0.0",
  "description": "Web app for Mogo, a self-hosted agent that tests a feature across a project's GitHub PRs and posts a code review on each.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:pull": "prisma db pull && prisma generate"
  },
  "dependencies": {
