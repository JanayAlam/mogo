# Password for the web UI (required in production: without it nobody can sign in)
APP_PASSWORD=

# Supabase Postgres connection string (use the pooler URL on Vercel). Tables: ../db/schema.sql
DATABASE_URL=

# Used only to start the runner workflow. Fine-grained PAT with Actions: read & write on RUNNER_REPO.
GITHUB_TOKEN=
RUNNER_REPO=your-user/agent-mogo
RUNNER_WORKFLOW=run-agent.yml
RUNNER_REF=main

# Optional allow-list (comma separated). Unset = the runner validates against repos.yaml.
ALLOWED_REPOS=

SENTRY_DSN=
