# Password for the web UI. Empty = no login screen locally; in production nobody gets in unless AUTH_DISABLED=true.
APP_PASSWORD=
# AUTH_DISABLED=true  # production without a password: anyone with the URL can start runs and post reviews

# Supabase Postgres connection string (use the pooler URL on Vercel). Tables: python -m mogo.tools.migrate (see README)
DATABASE_URL=

# Used only to start the runner workflow. Fine-grained PAT with Actions: read & write on RUNNER_REPO.
GITHUB_TOKEN=
RUNNER_REPO=your-user/agent-mogo
RUNNER_WORKFLOW=run-agent.yml
RUNNER_REF=main

# Encrypts repo secrets entered in the UI; the runner needs the same value. Create: openssl rand -base64 32
# Changing it makes stored secrets unreadable (re-enter them).
MOGO_SECRET_KEY=

SENTRY_DSN=
