# The Mogo GitHub App (README, Deploy, 2): sign-in, and which repos a user may add.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=mogo
# The App's webhook secret (openssl rand -hex 32); deliveries without it are refused.
GITHUB_WEBHOOK_SECRET=

# Supabase Postgres connection string (use the pooler URL on Vercel). Tables: python -m mogo.tools.migrate (see README)
DATABASE_URL=

# Used only to start the runner workflow. Fine-grained PAT with Actions: read & write on RUNNER_REPO.
GITHUB_TOKEN=
RUNNER_REPO=your-user/agent-mogo
RUNNER_WORKFLOW=run-agent.yml
RUNNER_REF=main

# Encrypts users' GitHub tokens and LLM keys, and repo secrets; the runner needs the same value.
# Create: openssl rand -base64 32. Changing it makes stored secrets unreadable (users re-enter them, and sign in again).
MOGO_SECRET_KEY=

SENTRY_DSN=
